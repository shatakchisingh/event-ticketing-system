{
  "name": "@event-ticketing/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "db:generate": "dotenv -e ../../.env -- prisma generate --schema ../../prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema ../../prisma/schema.prisma --name init",
    "db:seed": "dotenv -e ../../.env -- tsx ../../prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "dotenv-cli": "^10.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.1",
    "helmet": "^7.1.0",
    "nodemailer": "^6.9.14",
    "prisma": "^5.10.0",
    "qrcode": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.1",
    "@types/cookie-parser": "^1.0.0",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.15.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  }
}
